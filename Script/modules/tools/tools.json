    {
      "type": "function",
      "function": {
        "name": "search_diary",
        "description": "搜索日记。支持按正则表达式匹配日记内容，并可按日期范围过滤。有两种模式：命令式(mode='command'，默认)直接返回最多 max_entries 条结果；交互式(mode='interactive')不限制条目数，返回第一条匹配结果及 session_id，之后配合 next_diary/prev_diary 逐条浏览上一条/下一条。query 留空时匹配所有条目（即仅按日期范围检索）。",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "用于匹配日记内容的正则表达式。留空则匹配所有条目。若正则无效会自动按普通字符串匹配。"
            },
            "start_date": {
              "type": "string",
              "description": "检索的起始日期，格式 yyyy-mm-dd。默认不限制（最早）。"
            },
            "end_date": {
              "type": "string",
              "description": "检索的结束日期，格式 yyyy-mm-dd。默认不限制（最晚）。"
            },
            "mode": {
              "type": "string",
              "description": "搜索模式。'command' 直接返回结果（默认）；'interactive' 进入逐条浏览，配合 next_diary/prev_diary 跳转。"
            },
            "max_entries": {
              "type": "integer",
              "description": "命令式模式下返回的最大条目数，默认为 20。"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "next_diary",
